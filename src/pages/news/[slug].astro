---
const heroStyle = (a) => `${a.image ? `--hero-image:url(${a.image});--hero-size:${a.heroSize || 'cover'};--hero-pos:${a.heroPos || 'center'}${a.heroBg ? `;--hero-bg:${a.heroBg}` : ''}${a.heroPosMobile ? `;--hero-pos-m:${a.heroPosMobile}` : ''}` : ''}`;
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { getArticles, sections } from '../../lib/articles.js';

export function getStaticPaths() {
  return getArticles().map((a) => ({ params: { slug: a.slug }, props: { slug: a.slug } }));
}

const all = getArticles();
const article = all.find((a) => a.slug === Astro.props.slug);
const { Content, headings } = article;
const contents = headings.filter((h) => h.depth === 2);
const more = all.filter((a) => a.slug !== article.slug).slice(0, 4);
const fmt = (d) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const sectionLabel = sections.find((s) => s.id === article.section)?.label || 'News';
---
<Base title={`${article.title} — Aerial`} description={article.standfirst}>
  <section class="hero" aria-label="Article header">
    <div class="hero-img" role={article.image ? "img" : undefined} aria-label={article.image ? (article.imageAlt || "Article photo") : undefined} aria-hidden={article.image ? undefined : "true"} style={heroStyle(article)}></div>
    <Header current={sectionLabel} />
    <div class="hero-body">
      <div style="display:flex;flex-direction:column;gap:16px;max-width:980px">
        <nav aria-label="Breadcrumb" class="label"><a href="/news">News</a> / <a href={`/news?section=${article.section}`}>{sectionLabel}</a></nav>
        <h1>{article.title}</h1>
        {article.standfirst && <p style="margin:0;max-width:720px;font-size:16px;line-height:1.65;color:rgba(255,255,255,.9)">{article.standfirst}</p>}
        <span style="font-size:13px;color:rgba(255,255,255,.8)">By {article.author} · {fmt(article.date)}</span>
      </div>
      {article.score && <div style="display:flex;align-items:baseline;gap:6px"><span class="score">{article.score}</span><span style="font-size:13px;color:rgba(255,255,255,.8)">/10</span></div>}
    </div>
  </section>

  <div class="wrap" id="main" tabindex="-1">
    {article.sample && <p class="muted rule-b" style="margin:0;padding:10px 0;font-size:12px">Sample article showing the layout.</p>}
    <div class="article-layout rule-b">
      <aside class="a-side" aria-label="Article navigation">
        {contents.length > 0 && (
          <nav aria-label="In this article">
            <div class="side-h">In this article</div>
            {contents.map((h) => <a class="side-link" href={`#${h.slug}`}>{h.text}</a>)}
          </nav>
        )}
        <nav aria-label="Sections">
          <div class="side-h">Sections</div>
          {sections.map((s) => <a class:list={['side-link', { active: s.id === article.section }]} href={`/news?section=${s.id}`}>{s.label}</a>)}
          <a class="side-link" href="/news?section=wire">The Wire</a>
        </nav>
        {article.tags && (
          <nav aria-label="Tags">
            <div class="side-h">Tags</div>
            <div style="display:flex;flex-wrap:wrap;gap:6px">{article.tags.map((t) => <span class="tag">{t}</span>)}</div>
          </nav>
        )}
      </aside>

      <article class="prose">
        <Content />
        <div class="author-box">
          <span class="author-initials">{article.author.split(/[\s&]+/).filter(Boolean).map((w) => w[0]).join('').slice(0, 2)}</span>
          <span><strong>{article.author}</strong> writes for Aerial.</span>
        </div>
      </article>

      <aside class="a-rail" aria-label="Details">
        {article.score && (
          <div class="score-card">
            <span class="label" style="font-size:11px;color:#FF8A8A">Our score</span>
            <span class="serif" style="font-weight:700;font-size:84px;line-height:.9">{article.score}</span>
          </div>
        )}
        <div>
          <div class="side-h">Share</div>
          <div style="display:flex;gap:8px;flex-wrap:wrap">
            <a class="btn" style="height:38px" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(article.title)}`} target="_blank" rel="noopener">X</a>
            <button class="btn copy-link" style="height:38px" type="button">Copy link</button>
          </div>
        </div>
        <a href="mailto:hello@example.com" class="ad-slot">
          <span class="label" style="font-size:10px;opacity:.85">Ad space · 300 × 300</span>
          <span class="serif" style="font-weight:700;font-size:26px;line-height:1.1;margin-top:6px">Your label, club or festival here</span>
        </a>
      </aside>
    </div>

    <section aria-label="More stories" style="padding:32px 0 8px">
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:18px">
        <h2 class="label" style="margin:0;font-size:14px">More from Aerial</h2>
        <a class="link-red" style="font-size:12px" href="/news">All news</a>
      </div>
      <div class="more">
        {more.map((a) => (
          <a href={`/news/${a.slug}`} style="display:flex;flex-direction:column;gap:10px">
            <span class={`art art-${a.art || 'a'}`} style="aspect-ratio:1/1"></span>
            <span style="font-family:var(--cond);font-weight:700;font-size:17px;text-transform:uppercase">{a.title}</span>
            <span class="muted" style="font-size:12px">{a.score ? `${a.score} · ` : ''}{a.author}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .article-layout { display: grid; grid-template-columns: 240px minmax(0, 1fr) 300px; }
  .a-side { padding: 32px 24px 40px 0; border-right: var(--line); display: flex; flex-direction: column; gap: 32px; }
  .side-h { padding-bottom: 10px; margin-bottom: 8px; border-bottom: 1px solid var(--ink); font-family: var(--cond); font-weight: 700; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; }
  .side-link { display: flex; align-items: center; min-height: 38px; padding-left: 12px; border-left: 3px solid transparent; font-family: var(--cond); font-weight: 600; font-size: 15px; letter-spacing: 0.04em; text-transform: uppercase; }
  .side-link.active { border-left-color: var(--red); color: var(--red); font-weight: 700; }
  .prose { padding: 40px 48px 48px; max-width: 760px; font-size: 16px; line-height: 1.8; color: #2A2622; }
  .prose :global(h2) { margin: 36px 0 14px; font-family: var(--serif); font-weight: 700; font-size: 32px; color: var(--ink); scroll-margin-top: 24px; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p) { margin: 0 0 22px; }
  .prose :global(blockquote) { margin: 32px 0; padding: 20px 0 20px 24px; border-left: 3px solid var(--red); font-family: var(--serif); font-style: italic; font-size: 30px; line-height: 1.3; color: var(--ink); }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(a) { color: var(--red); text-decoration: underline; text-underline-offset: 3px; }
  .author-box { display: flex; align-items: center; gap: 16px; margin-top: 36px; padding: 20px; border: var(--line); border-radius: 8px; font-size: 13px; }
  .author-initials { flex: none; width: 52px; height: 52px; border-radius: 999px; border: var(--line); display: flex; align-items: center; justify-content: center; font-family: var(--serif); font-weight: 700; color: var(--red); }
  .a-rail { padding: 40px 0 48px 28px; border-left: var(--line); display: flex; flex-direction: column; gap: 28px; }
  .score-card { padding: 22px; border-radius: 8px; background: var(--ink); color: var(--paper); display: flex; flex-direction: column; gap: 6px; }
  .ad-slot { display: flex; flex-direction: column; justify-content: flex-end; aspect-ratio: 1 / 1; padding: 20px; border-radius: 8px; color: #fff; background: linear-gradient(0deg, rgba(11,11,13,.85) 0%, rgba(11,11,13,.2) 60%), url(/images/liquid-metal-h.webp) center / cover no-repeat, #18171b; }
  .ad-slot:hover { color: #fff; }
  .more { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; }
  @media (max-width: 1100px) {
    .article-layout { grid-template-columns: 1fr; }
    .a-side, .a-rail { border: 0; padding-left: 0; padding-right: 0; }
    .prose { padding-left: 0; padding-right: 0; }
  }
</style>

<script>
  document.querySelectorAll('.copy-link').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(location.href); b.textContent = 'Copied'; } catch { b.textContent = 'Copy failed'; }
  }));
  // Highlight the section of the article currently on screen.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('nav[aria-label="In this article"] .side-link')];
  const targets = links.map((l) => document.querySelector(decodeURIComponent(l.hash))).filter(Boolean) as Element[];
  if ('IntersectionObserver' in window && targets.length) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        links.forEach((l) => l.classList.toggle('active', l.hash === '#' + en.target.id));
      });
    }, { rootMargin: '0px 0px -70% 0px' });
    targets.forEach((t) => io.observe(t));
  }
</script>
