---
import { nav } from '../data/nav.js';
const { solid = false, current = '' } = Astro.props;
---
<header class:list={['site-header', { solid }]}>
  <a href="/" class="logo" aria-label="Quicksilver home">Quicksilver</a>
  <nav id="main-nav" class="main-nav" aria-label="Main">
    {nav.map((item) => (
      <a href={item.href} aria-current={current === item.label ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
  <div style="display:flex;gap:10px;align-items:center">
    <a href="#newsletter" class="btn btn-red">Newsletter</a>
    <button class="btn nav-toggle" aria-controls="main-nav" aria-expanded="false" style={solid ? '' : 'color:#fff;border-color:#fff'}>Menu</button>
  </div>
</header>
<script>
  document.querySelectorAll('.nav-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const navEl = document.getElementById('main-nav');
      const open = navEl?.classList.toggle('open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });
</script>
