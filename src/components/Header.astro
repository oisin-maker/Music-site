---
import { nav } from '../data/nav.js';
import MobileMenu from './MobileMenu.astro';
const { solid = false, current = '', cta = { href: '#newsletter', label: 'Newsletter' } } = Astro.props;
---
<header class:list={['site-header', { solid }]}>
  <a href="/" class="logo" aria-label="Small Rooms home">Small Rooms</a>
  <nav id="main-nav" class="main-nav" aria-label="Main">
    {nav.map((item) => (
      <a href={item.href} aria-current={current === item.label ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
  <div style="display:flex;gap:10px;align-items:center">
    <a href={cta.href} class="btn btn-red">{cta.label}</a>
    <button class="btn nav-toggle" aria-controls="mobile-menu" aria-expanded="false" style={solid ? '' : 'color:#fff;border-color:#fff'}>Menu</button>
  </div>
</header>
<MobileMenu current={current} />
