---
import { gigs, gigWeek, sceneLabels, thames, toMap } from '../data/home.js';
import { majorRoads } from '../data/streets.js';
import { accessLevels } from '../data/venueAccess.js';
const stepFree = gigs.filter((g) => g.access.level === 'step-free').length;
// Roads and river in the SVG's 400 x 300 space, from real coordinates.
// Lines are smoothed into gentle curves through the points rather than drawn as straight segments.
const pt = ([lat, lng]) => { const p = toMap(lat, lng); return [p.x * 4, p.y * 3]; };
const f = (n) => n.toFixed(1);
const line = (latlngs) => {
  const P = latlngs.map(pt);
  if (P.length < 3) return `M${f(P[0][0])} ${f(P[0][1])}` + P.slice(1).map(([x, y]) => ` L${f(x)} ${f(y)}`).join('');
  let d = `M${f(P[0][0])} ${f(P[0][1])}`;
  for (let i = 0; i < P.length - 1; i++) {
    const p0 = P[i - 1] || P[i], p1 = P[i], p2 = P[i + 1], p3 = P[i + 2] || p2;
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${f(c1[0])} ${f(c1[1])} ${f(c2[0])} ${f(c2[1])} ${f(p2[0])} ${f(p2[1])}`;
  }
  return d;
};
// Access notes: show the first sentence, keep the rest one tap away.
const firstSentence = (t) => { const m = t.match(/^.*?[.!?](\s|$)/); return m ? m[0].trim() : t; };
const restOf = (t) => t.slice(firstSentence(t).length).trim();
const roads = majorRoads.map(line);
const river = line(thames);
// A few faint area names so the pins have context. Positions are lat/lng, nudged clear of pins.
const areas = [
  ['Camden', 51.566, -0.156], ['Hackney', 51.565, -0.045], ['Brixton', 51.450, -0.112], ['New Cross', 51.471, -0.034],
].map(([name, lat, lng]) => ({ name, ...toMap(lat, lng) }));
---
<section id="map" class="rule-b gm-inv" style="padding:28px 0 36px">
  <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:18px">
    <h2 class="label" style="margin:0;font-size:14px">Gig map · {gigs.length} picks this week</h2>
    <span class="muted" style="font-size:12px">{gigWeek} · real listings, curated by Aerial</span>
  </div>
  <div class="gm-filters" role="group" aria-label="Filter by scene">
    <button type="button" class="gm-chip" data-scene="all" aria-pressed="true">All {gigs.length}</button>
    {Object.entries(sceneLabels).map(([k, label]) => (
      <button type="button" class="gm-chip" data-scene={k} aria-pressed="false">{label} {gigs.filter((x) => x.scene === k).length}</button>
    ))}
    <button type="button" class="gm-chip gm-access-toggle" aria-pressed="false">Step-free only {stepFree}</button>
  </div>
  <div class="gm">
    <div class="gm-map" role="group" aria-label="Map of this week's picks">
      <svg viewBox="0 0 400 300" preserveAspectRatio="none" aria-hidden="true">
        <g class="gm-roads">{roads.map((d) => <path d={d} />)}</g>
        <path class="gm-thames" d={river} />
      </svg>
      {areas.map((a) => <span class="gm-place" aria-hidden="true" style={`left:${a.x}%;top:${a.y}%`}>{a.name}</span>)}
      <span class="gm-river">River Thames</span>
      {gigs.map((g, i) => (
        <button class="gm-pin" data-i={i} data-scene={g.scene} data-access={g.access.level} style={`left:${g.x}%;top:${g.y}%`} aria-pressed={i === 0 ? 'true' : 'false'} tabindex="-1" aria-label={`${i + 1}. ${g.day}: ${g.act} at ${g.venue}`}>
          <span>{i + 1}</span>
        </button>
      ))}
    </div>
    <ol class="gm-list">
      {gigs.map((g, i) => (
        <li data-scene={g.scene} data-access={g.access.level}>
          <button class="gm-row" data-i={i} aria-expanded={i === 0 ? 'true' : 'false'}>
            <span class="gm-n">{i + 1}</span>
            <span class="label" style="font-size:13px">{g.day} {g.time}</span>
            <span style="min-width:0"><span class="gm-act">{g.act}</span><span class="muted" style="display:block;font-size:12px">{g.venue} · {g.area}</span><span class={`gm-acc gm-acc-${g.access.level}`}><span aria-hidden="true">{accessLevels[g.access.level].icon}</span> {accessLevels[g.access.level].label}</span></span>
            <span class="muted" style="font-size:12px">{g.price}</span>
          </button>
          <div class="gm-detail" hidden={i !== 0}>
            <span class="muted" style="font-size:13px">{g.note}</span>
            <div class="gm-access">
              <span style="font-size:13px"><span class="label" style="font-size:11px">Access:</span> {firstSentence(g.access.summary)}</span>
              <details>
                <summary>More access info</summary>
                {restOf(g.access.summary) && <p>{restOf(g.access.summary)}</p>}
                {g.access.extras.length > 0 && <ul>{g.access.extras.map((x) => <li>{x}</li>)}</ul>}
                <p class="muted">{g.access.source ? <>From <a href={g.access.source} target="_blank" rel="noopener">{g.access.sourceLabel}</a>, checked {g.access.checked}.</> : <>Checked {g.access.checked}.</>} Always confirm with the venue. <a href="/accessibility#venues">How we check</a></p>
              </details>
            </div>
            <span style="display:flex;flex-wrap:wrap;gap:8px;align-items:center">
              <span class="tag gm-scene">{sceneLabels[g.scene]}</span>{g.tags.map((t) => <span class="tag">{t}</span>)}
              {g.url && <a class="btn btn-red" style="margin-left:auto;height:36px" href={g.url} target="_blank" rel="noopener">Tickets ↗</a>}
            </span>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* Inverted band: black ground, off-white type, the opposite of the rest of the site */
  .gm-inv { --ink: #FAF8F3; --paper: #161513; --muted: #B9B2A8; --red-soft: rgba(255,107,107,.45); background: #161513; color: #FAF8F3; margin: 0 calc(-1 * var(--gutter)); padding-left: var(--gutter) !important; padding-right: var(--gutter) !important; }
  .gm-inv .tag { border-color: #FF8A8A; color: #FF8A8A; }
  .gm-inv .gm-row[aria-expanded="true"] .gm-act { color: #FF6B6B; }
  .gm { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 28px; align-items: start; }
  /* The map data is drawn for a 4:5 frame, so keep that shape and let it stay in view while the list scrolls. */
  .gm-map { position: sticky; top: 16px; width: min(100%, calc((100vh - 32px) * 0.8)); border: 1px solid rgba(250,248,243,.22); border-radius: 8px; overflow: hidden; background: #1C1B18; }
  .gm-map::before { content: ''; display: block; padding-top: 125%; } /* 4:5, works in every browser */
  .gm-map svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .gm-roads path { fill: none; stroke: #FAF8F3; stroke-opacity: 0.13; stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .gm-thames { fill: none; stroke: #2C4556; stroke-width: 9; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .gm-river { position: absolute; left: 3%; top: 64%; font-family: var(--serif); font-style: italic; font-size: 14px; color: #7E9CB0; pointer-events: none; }
  .gm-place { position: absolute; transform: translate(-50%, -50%); font-family: var(--cond); font-weight: 600; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(250,248,243,.38); white-space: nowrap; pointer-events: none; }
  .gm-pin { position: absolute; transform: translate(calc(-50% + var(--dx, 0px)), calc(-50% + var(--dy, 0px))); display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; padding: 0; border: 0; background: transparent; cursor: pointer; }
  .gm-pin span { width: 26px; height: 26px; border-radius: 999px; background: #FAF8F3; color: #161513; display: flex; align-items: center; justify-content: center; font-family: var(--cond); font-weight: 700; font-size: 12px; box-shadow: 0 0 0 3px #1C1B18; transition: transform .15s; }
  .gm-pin:hover span { transform: scale(1.12); }
  .gm-pin[aria-pressed="true"] { z-index: 2; }
  .gm-pin[aria-pressed="true"] span { width: 30px; height: 30px; background: var(--red); color: #fff; box-shadow: 0 0 0 3px #1C1B18, 0 4px 14px rgba(212,0,0,.45); }
  .gm-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .gm-list > li { border-bottom: 1px solid var(--red-soft); }
  .gm-row { width: 100%; min-height: 52px; display: grid; grid-template-columns: 28px 92px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 12px 0; border: 0; background: transparent; color: var(--ink); text-align: left; cursor: pointer; font-family: var(--mono); }
  .gm-row[aria-expanded="true"] .gm-act { color: var(--red); }
  .gm-n { width: 24px; height: 24px; border-radius: 999px; border: 1px solid var(--ink); display: flex; align-items: center; justify-content: center; font-family: var(--cond); font-weight: 700; font-size: 11px; }
  .gm-act { display: block; font-family: var(--cond); font-weight: 700; font-size: 16px; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .gm-detail { display: flex; flex-direction: column; gap: 10px; padding: 0 0 16px 40px; }
  .gm-pin[hidden], .gm-list > li[hidden] { display: none !important; }
  .gm-filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 16px; }
  .gm-chip { height: 34px; padding: 0 14px; border: 1px solid var(--ink); border-radius: 999px; background: transparent; color: var(--ink); font-family: var(--cond); font-weight: 700; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; }
  .gm-chip[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  .gm-acc { display: inline-flex; gap: 4px; margin-top: 2px; font-family: var(--cond); font-weight: 600; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; }
  .gm-acc-step-free { color: #8FD9A8; } .gm-acc-partial { color: #F2C46D; } .gm-acc-no { color: #FF8A8A; } .gm-acc-unknown { color: #B9B2A8; }
  .gm-access { display: flex; flex-direction: column; gap: 4px; }
  .gm-access details { font-size: 12px; }
  .gm-access summary { cursor: pointer; width: fit-content; min-height: 24px; color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
  .gm-access details p { margin: 6px 0 0; }
  .gm-access ul { margin: 6px 0 0; padding-left: 18px; }
  .gm-access a { text-decoration: underline; text-underline-offset: 3px; }
  .gm-inv .gm-scene { border-color: #FAF8F3; color: #FAF8F3; }
  @media (max-width: 900px) { .gm { grid-template-columns: 1fr; } .gm-map { position: relative; top: 0; width: 100%; } }
  @media (max-width: 600px) { .gm-act { white-space: normal; } .gm-place { font-size: 10px; } .gm-pin span { width: 24px; height: 24px; font-size: 11px; } .gm-pin[aria-pressed="true"] span { width: 28px; height: 28px; } }
</style>

<script>
  const select = (i: string) => {
    document.querySelectorAll('.gm-pin').forEach((p) => p.setAttribute('aria-pressed', (p as HTMLElement).dataset.i === i ? 'true' : 'false'));
    document.querySelectorAll('.gm-row').forEach((r) => {
      const on = (r as HTMLElement).dataset.i === i;
      r.setAttribute('aria-expanded', on ? 'true' : 'false');
      const d = r.nextElementSibling as HTMLElement | null;
      if (d) d.hidden = !on;
    });
  };
  document.querySelectorAll('.gm-pin, .gm-row').forEach((el) => el.addEventListener('click', () => select((el as HTMLElement).dataset.i || '0')));
  // Push apart pins that sit too close together, so every pin has a clear tap target (WCAG 2.5.8).
  const spreadPins = () => {
    const map = document.querySelector<HTMLElement>('.gm-map');
    if (!map) return;
    const pins = Array.from(map.querySelectorAll<HTMLElement>('.gm-pin')).filter((p) => !p.hidden);
    const W = map.clientWidth, H = map.clientHeight;
    const pts = pins.map((p) => ({ p, x: (parseFloat(p.style.left) / 100) * W, y: (parseFloat(p.style.top) / 100) * H, dx: 0, dy: 0 }));
    const gap = (pins[0]?.offsetWidth || 28) + 6;
    for (let it = 0; it < 60; it++) {
      let moved = false;
      for (let a = 0; a < pts.length; a++) for (let b = a + 1; b < pts.length; b++) {
        const A = pts[a], B = pts[b];
        let vx = (B.x + B.dx) - (A.x + A.dx), vy = (B.y + B.dy) - (A.y + A.dy);
        let d = Math.hypot(vx, vy);
        if (d >= gap) continue;
        if (d < 0.01) { vx = 1; vy = 0; d = 1; }
        const push = (gap - d) / 2;
        A.dx -= (vx / d) * push; A.dy -= (vy / d) * push;
        B.dx += (vx / d) * push; B.dy += (vy / d) * push;
        moved = true;
      }
      if (!moved) break;
    }
    pts.forEach(({ p, dx, dy }) => { p.style.setProperty('--dx', `${dx.toFixed(1)}px`); p.style.setProperty('--dy', `${dy.toFixed(1)}px`); });
  };
  spreadPins();
  window.addEventListener('resize', spreadPins);
  let scene = 'all';
  let stepFreeOnly = false;
  const applyFilters = () => {
    let first: string | null = null;
    document.querySelectorAll<HTMLElement>('.gm-pin, .gm-list > li').forEach((el) => {
      const show = (scene === 'all' || el.dataset.scene === scene) && (!stepFreeOnly || el.dataset.access === 'step-free');
      el.hidden = !show;
      if (show && !first && el.classList.contains('gm-pin')) first = el.dataset.i || null;
    });
    if (first) select(first);
    spreadPins();
  };
  document.querySelectorAll<HTMLElement>('.gm-chip[data-scene]').forEach((chip) => chip.addEventListener('click', () => {
    scene = chip.dataset.scene || 'all';
    document.querySelectorAll('.gm-chip[data-scene]').forEach((c) => c.setAttribute('aria-pressed', c === chip ? 'true' : 'false'));
    applyFilters();
  }));
  const accToggle = document.querySelector<HTMLElement>('.gm-access-toggle');
  accToggle?.addEventListener('click', () => {
    stepFreeOnly = !stepFreeOnly;
    accToggle.setAttribute('aria-pressed', String(stepFreeOnly));
    applyFilters();
  });
</script>
